# Copy to .env.development.local (git-ignored) to pre-fill Settings in the dev
# browser started by `yarn start`. These values are never used by `yarn build`.

# OpenRouter API key, seeded into localStorage when none is stored yet
REACT_APP_OPENROUTER_API_KEY=

# Comma-separated model ids offered in the agent form when none are selected yet
REACT_APP_DEV_MODELS=anthropic/claude-haiku-4.5,openai/gpt-4o-mini
